# Database (SQLite file, relative to packages/database)
DATABASE_URL="file:./dev.db"

# API server
API_PORT=3001

# Evidence retrieval (optional). Operator contact sent to Crossref and NCBI so
# requests join their "polite" pools. Leave empty to send no contact details.
# Never put an uploader's personal email here.
CITEVERIFY_CONTACT_EMAIL=

# Claim verification (optional). Local Ollama server and model; prompts never
# leave this machine. Install a model with: ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
