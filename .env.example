# Database (SQLite file, relative to packages/database)
DATABASE_URL="file:./dev.db"

# API server
API_PORT=3001

# Evidence retrieval (optional). Operator contact sent to Crossref and NCBI so
# requests join their "polite" pools. Leave empty to send no contact details.
# Never put an uploader's personal email here.
CITEVERIFY_CONTACT_EMAIL=

# Claim verification (optional). Local Ollama server and model; prompts never
# leave this machine. Install a model with: ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Hosted verification (optional; used by the public site). When GROQ_API_KEY is
# set, claims and retrieved public passages (never the PDF) are sent to Groq
# instead of Ollama. Set VERIFIER_PROVIDER=ollama to force the local model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
VERIFIER_PROVIDER=

# Optional free OpenAlex API key (server-side only). OpenAlex now meters
# anonymous use per IP address, which shared hosts can exhaust.
OPENALEX_API_KEY=
