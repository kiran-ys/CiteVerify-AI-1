{
  "name": "@citeverify/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun --env-file=../../.env dist/index.js",
    "lint": "biome lint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@citeverify/citation-engine": "workspace:*",
    "@citeverify/claim-extractor": "workspace:*",
    "@citeverify/database": "workspace:*",
    "@citeverify/document-parser": "workspace:*",
    "@citeverify/evidence-retrieval": "workspace:*",
    "@citeverify/shared": "workspace:*",
    "@citeverify/verification-engine": "workspace:*",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@citeverify/config": "workspace:*",
    "@types/bun": "^1.4.4"
  }
}
