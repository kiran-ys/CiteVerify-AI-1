# Public domain pointing at this server (Caddy gets an HTTPS certificate for it).
# Use ":80" only for a quick HTTP test.
SITE_ADDRESS=citeverify.example.org

# Local model served by the Ollama container. Keep llama3.2 until the
# model comparison is reviewed.
OLLAMA_MODEL=llama3.2

# Operator mailbox for Crossref/NCBI polite pools (never a user's email). Optional.
CITEVERIFY_CONTACT_EMAIL=

# Demo password in front of the whole site (required; the site will not start without it). Create the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Write the hash in single quotes: it contains $ signs.
DEMO_USER=judge
DEMO_PASSWORD_HASH=
